function ra(){let dateFiltre=document.getElementById('filtreDatePrixAchat')?document.getElementById('filtreDatePrixAchat').value:'';let tb=document.getElementById('at');tb.innerHTML='';P.forEach((p,idx)=>{if(dateFiltre && p.date && p.date!=dateFiltre) return;let m=(p.gros-p.achat).toLocaleString();tb.innerHTML+=`<tr><td style="text-align:left"><b>${p.nom}</b></td><td><input value="${p.achat}" type="number" style="width:75px;border:3px solid red;border-radius:5px;text-align:center;font-weight:900" onchange="P[${idx}].achat=parseFloat(this.value)||0;sv();ra();"></td><td><input value="${p.gros}" type="number" style="width:75px;border:3px solid blue;border-radius:5px;text-align:center;font-weight:900" onchange="P[${idx}].gros=parseFloat(this.value)||0;sv();ra();"></td><td><input value="${p.detail}" type="number" style="width:75px;border:3px solid #ffcc00;border-radius:5px;text-align:center;font-weight:900" onchange="P[${idx}].detail=parseFloat(this.value)||0;sv();ra();"></td><td style="background:#c8e6c9;font-weight:900">${m}</td><td style="font-size:7px">${p.date||'-'}</td><td><button onclick="sp2(${idx})" style="background:red;color:#fff;border-radius:4px;padding:4px">X</button></td></tr>`;});}
