function n2f(n){const o=['','un','deux','trois','quatre','cinq','six','sept','huit','neuf','dix','onze','douze','treize','quatorze','quinze','seize','dix-sept','dix-huit','dix-neuf'];const t=['','dix','vingt','trente','quarante','cinquante','soixante','soixante-dix','quatre-vingt','quatre-vingt-dix'];if(n==0)return 'zéro';if(n<20)return o[n];if(n<100){let a=Math.floor(n/10),b=n%10;return t[a]+(b?'-'+o[b]:'');}if(n<1000){let c=Math.floor(n/100),r=n%100;return (c>1?o[c]+' cent':'cent')+(r?' '+n2f(r):'');}if(n<1000000){let m=Math.floor(n/1000),r=n%1000;return (m>1?n2f(m)+' mille':'mille')+(r?' '+n2f(r):'');}return n.toString();}
